TELEGRAM_BOT_TOKEN=
GEMINI_API_KEYS=

# Pakai link clone/test form saat testing. Jangan pakai form kerja asli untuk uji coba upload.
GOOGLE_FORM_URL=https://docs.google.com/forms/d/e/1FAIpQLSc76D52k65y5p79Me7MNhz-5kJldkmR6VC2q82BQjjyXlC4Wg/viewform

# Optional. Pisahkan dengan koma. Chat ID admin bisa melihat semua log, user biasa hanya log miliknya.
ADMIN_CHAT_IDS=

# Optional. Batas jumlah baris detail untuk /gagal, /gagal_tid, dan /tid.
LOG_DETAIL_LIMIT=50

# Optional. Jeda antar pesan saat /confirm_announce agar broadcast tidak terlalu rapat.
ANNOUNCEMENT_SEND_DELAY=0.1

# Optional. Isi hanya kalau lokasi Edge berbeda dari default Windows.
EDGE_EXECUTABLE=

# Optional. Default otomatis memakai folder darul/ jika ada, lalu bot_profile/.
EDGE_USER_DATA_DIR=
